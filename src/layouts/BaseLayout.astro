---
import "../styles/global.css";
import Paw from "../components/Paw.astro";
import { url, localized, splitPath, lessonPaths } from "../lib/url";
import { ui, languages, langs } from "../i18n/ui";

interface Props {
  title: string;
  description?: string;
}

// The language comes from the address: /de/... is German, /cat/... is Cat, everything else English
const { lang, path: currentPath } = splitPath(Astro.url.pathname);
const t = ui[lang];
const { title, description = t.defaultDescription } = Astro.props;

const links = [
  { path: "/", label: t.nav.home },
  { path: lessonPaths[0], label: t.nav.nap },
  { path: lessonPaths[1], label: t.nav.breakfast },
  { path: lessonPaths[2], label: t.nav.zoomies },
  { path: "/quiz", label: t.nav.quiz },
];
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="icon" href={url("/favicon.ico")} />
    {
      langs.map((l) => (
        <link rel="alternate" hreflang={languages[l].htmlLang} href={localized(currentPath, l)} />
      ))
    }
    <title>{title} · Kesya's OnlyPaws</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-title" href={localized("/", lang)}>
          <Paw size={28} color="var(--gold)" />
          Kesya's OnlyPaws
        </a>
        <nav class="site-nav" aria-label={t.nav.label}>
          <ul>
            {
              links.map((link) => (
                <li>
                  <a
                    href={localized(link.path, lang)}
                    aria-current={currentPath === link.path ? "page" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <nav class="lang-switch" aria-label={t.languageSwitch}>
          <ul>
            {
              langs.map((l) => (
                <li>
                  <a
                    href={localized(currentPath, l)}
                    hreflang={languages[l].htmlLang}
                    lang={languages[l].htmlLang}
                    title={languages[l].name}
                    aria-current={l === lang ? "true" : undefined}
                  >
                    {languages[l].label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        <Paw size={20} color="var(--gold)" />
        {t.footer}
        <Paw size={20} color="var(--gold)" />
      </p>
    </footer>
  </body>
</html>
