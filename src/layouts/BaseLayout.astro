---
import "../styles/global.css";
import Paw from "../components/Paw.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Kesya the cat shares her wisdom: napping, second breakfast and zoomies." } = Astro.props;

const links = [
  { href: "/", label: "Home" },
  { href: "/lessons/nap", label: "1 · Nap" },
  { href: "/lessons/second-breakfast", label: "2 · Second Breakfast" },
  { href: "/lessons/zoomies", label: "3 · Zoomies" },
  { href: "/quiz", label: "Quiz" },
];

// Remove a trailing slash so "/quiz/" and "/quiz" both match
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} · Kesya's OnlyPaws</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-title" href="/">
          <Paw size={28} color="var(--yellow)" />
          Kesya's OnlyPaws
        </a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {
              links.map((link) => (
                <li>
                  <a href={link.href} aria-current={current === link.href ? "page" : undefined}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        <Paw size={20} color="var(--white)" />
        Wisdom by Kesya · Typing by her human servant
        <Paw size={20} color="var(--white)" />
      </p>
    </footer>
  </body>
</html>
