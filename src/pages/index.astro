---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Paw from "../components/Paw.astro";
import posterImage from "../assets/kesya/poster.jpg";

const lessons = [
  {
    href: "/lessons/nap",
    number: 1,
    title: "The Art of the Nap",
    teaser: "Find the best sun spot and master the perfect sleeping position.",
    color: "var(--surface-2)",
  },
  {
    href: "/lessons/second-breakfast",
    number: 2,
    title: "Operation Second Breakfast",
    teaser: "Convince your human that the first breakfast never happened.",
    color: "var(--surface-2)",
  },
  {
    href: "/lessons/zoomies",
    number: 3,
    title: "The Zoomie Party",
    teaser: "Lure your human servants away from the screen and into the fun.",
    color: "var(--surface-2)",
  },
];
---

<BaseLayout title="Home">
  <div class="card">
    <div class="hero">
      <div class="hero__text">
        <h1>Welcome to Kesya's OnlyPaws</h1>
        <p>
          Hello, human. I am <strong>Kesya</strong>: tabby, professional napper and part-time food
          critic. For years I have trained my human servants. Now I share my wisdom with you, in
          three short lessons and one little quiz.
        </p>
        <p>Each lesson takes about two minutes. That is shorter than my average stretch.</p>
        <a class="button" href="/lessons/nap">Start lesson 1</a>
      </div>
      <Image
        class="hero__photo"
        src={posterImage}
        alt="Glamorous dark and gold poster titled Kesya's OnlyPaws: an illustrated tabby cat winks from a velvet bed, next to a list of joke membership perks and a golden Subscribe4Meows button"
        width={500}
      />
    </div>

    <h2 class="lessons-heading">
      <Paw size={28} color="var(--gold)" /> The lessons
    </h2>
    <ol class="lesson-list">
      {
        lessons.map((lesson) => (
          <li style={`background:${lesson.color}`}>
            <a href={lesson.href}>
              Lesson {lesson.number}: {lesson.title}
            </a>
            <p>{lesson.teaser}</p>
          </li>
        ))
      }
    </ol>

    <p class="quiz-cta">
      Think you have learned enough? <a class="button" href="/quiz">Take the quiz</a>
    </p>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 3fr 2fr;
    }
  }

  .lessons-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }

  .lesson-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 48rem) {
    .lesson-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .lesson-list li {
    padding: 1rem 1.25rem;
    border: 1px solid var(--gold-dark);
    border-radius: var(--radius);
  }

  .lesson-list a {
    font-size: 1.1rem;
  }

  .lesson-list p {
    margin: 0.5rem 0 0;
  }

  .quiz-cta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
</style>
