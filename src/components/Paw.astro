---
// A decorative cat paw. Hidden from screen readers because it carries no meaning.
interface Props {
  size?: number;
  color?: string;
  rotate?: number;
  style?: string;
}

const { size = 32, color = "currentColor", rotate = 0, style = "" } = Astro.props;
---

<svg
  aria-hidden="true"
  focusable="false"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill={color}
  style={`transform: rotate(${rotate}deg); ${style}`}
>
  <ellipse cx="32" cy="42" rx="15" ry="13" />
  <ellipse cx="13" cy="25" rx="6" ry="8" transform="rotate(-20 13 25)" />
  <ellipse cx="25" cy="14" rx="6" ry="8" transform="rotate(-8 25 14)" />
  <ellipse cx="39" cy="14" rx="6" ry="8" transform="rotate(8 39 14)" />
  <ellipse cx="51" cy="25" rx="6" ry="8" transform="rotate(20 51 25)" />
</svg>
